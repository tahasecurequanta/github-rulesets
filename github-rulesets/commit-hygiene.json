{
  "name": "commit-hygiene",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "operator": "regex",
        "negate": false,
        "name": "Conventional Commits",
        "pattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\(.+\\))?!?: .+"
      }
    }
  ],
  "bypass_actors": []
}
